# Copy this file to .env and paste your keys. Never share or commit .env.
# Each key comes from a different API in your Trafiklab project.

# API: "GTFS Regional Static"
GTFS_STATIC_KEY=
# API: "GTFS Regional Realtime"
GTFS_REALTIME_KEY=
# API: "Trafiklab Realtime APIs"
TRAFIKLAB_REALTIME_KEY=

# Optional overrides
# LINE=121
# STOP_NAME=Knektaparken
# AREA_ID=
# BUSY_START=06:00
# BUSY_END=10:00
